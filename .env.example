# WebSocket-to-TCP proxy URL for Lightning peer connections.
# Optional — defaults to wss://proxy.zinqq.app if unset.
VITE_WS_PROXY_URL=wss://proxy.zinqq.app

# Esplora API URL override for both LDK and BDK.
# Optional — defaults to /api/esplora (Vercel serverless proxy to Blockstream Enterprise).
# VITE_ESPLORA_URL=https://mempool.space/api

# VSS (Versioned Storage Service) URL for encrypted remote state backup.
# Defaults to /api/vss-proxy (Vercel serverless function).
# In local dev, set to /__vss_proxy/vss so the Vite proxy handles it.
VITE_VSS_URL=/__vss_proxy/vss

# Backend target for the Vite dev proxy (/__vss_proxy -> this URL).
# Only used by the Vite dev server; not shipped to the browser.
# Defaults to http://localhost:8080 if unset.
VSS_PROXY_TARGET=http://localhost:8080

# Backend target for the Vite dev proxy (/api/esplora -> this URL).
# Tunnels Esplora requests to a deployed serverless proxy that already
# holds Blockstream Enterprise OAuth credentials, avoiding public API
# rate limits during local dev. Only used by the Vite dev server.
# Defaults to https://zinqq.app if unset.
ESPLORA_PROXY_TARGET=https://zinqq.app

# LSP (Lightning Service Provider) for LSPS2 JIT channels — Megalith.
# Required — no hardcoded defaults. Set these for your network.
VITE_LSP_NODE_ID=
VITE_LSP_HOST=
VITE_LSP_PORT=9735
# VITE_LSP_TOKEN=
# Telemetry / display tag for the node above. Defaults to "megalith"; set it
# when pointing at a different LSP so logs don't misattribute its behavior.
# VITE_LSP_LABEL=

# Static invoice server for the BOLT 12 async-payments recipient role.
# Optional — empty disables the feature entirely and leaves receive unchanged.
#
# Paths are hex of the server's Vec<BlindedMessagePath> blob, obtained
# out-of-band from the server operator — the same encoding ldk-node's uniffi
# bindings emit for async-recipient paths.
#
# The wallet cannot verify who these paths lead to. They are blinded, and a
# server builds them introducing at its own peers rather than at itself, so
# there is nothing to pin against. Trust rests on where this value came from;
# treat it like a credential, not a public address.
#
# This is LDK's internal Writeable encoding, not a BOLT wire format, so in
# principle both ends must pin the same LDK revision. The wallet is on
# lightningdevkit 0.2.4-0 (LDK v0.2.4-35-g7b76df2aeae61b3e); a blob written by
# lightning 0.3.0+git has been read back by it intact.
#
# Single-recipient only. The server issues these paths against a unique
# recipient_id, so one path set names one wallet — a value baked into a
# shared bundle cannot serve multiple users.
# SINGLE RECIPIENT ONLY — this is a correctness constraint, not a limitation.
# The server issues these paths against a recipient_id that must uniquely
# identify one recipient, and it keys its store on that id
# (static_invoices/<sha256(recipient_id)>/<invoice_slot>). Shipping one bundle
# to two wallets makes them overwrite each other's static invoices in a shared
# keyspace, silently. Nothing at runtime can detect it, so setting the paths
# also requires acknowledging this explicitly.
VITE_STATIC_INVOICE_SERVER_PATHS=
VITE_STATIC_INVOICE_SERVER_RECIPIENT_ACK=
