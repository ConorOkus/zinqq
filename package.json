    "@noble/secp256k1": "^3.2.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "lightningdevkit": "0.2.4-0",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.74.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
